# ==============================================================================
# Fragma IoT Dashboard - Environment Configuration Template
# Copy this file to .env and adjust the values according to your environment.
# DO NOT commit .env with real credentials or secrets to version control.
# ==============================================================================

# Database Connection (MySQL / MariaDB via Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fragma
DB_USER=root
DB_PASS=

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://fragma.test
